@model CertEasy.Model.Exam
@{
    ViewData["Title"] = "Edit Exam";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h5 class="card-title mb-0">Modify Exam: @Model.ExamName</h5>
            </div>
            <div class="card-body">
                <form asp-action="EditExam" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="ExamName" class="form-label">Exam Name</label>
                        <input asp-for="ExamName" class="form-control" />
                        <span asp-validation-for="ExamName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExamCenter" class="form-label">Exam Center</label>
                        <input asp-for="ExamCenter" class="form-control" />
                        <span asp-validation-for="ExamCenter" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExamSlot" class="form-label">Exam Slot (Date and Time)</label>
                        <input asp-for="ExamSlot" type="datetime-local" class="form-control" value="@Model.ExamSlot.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ExamSlot" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="ManageExams" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}