@model CertEasy.Web.Models.AssignBadgeViewModel
@{
    ViewData["Title"] = "Assign Badge";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <h4 class="mb-0"><i class="bi bi-award me-2"></i>Assign Badge</h4>
                    <span class="badge bg-light text-dark">App #@Model.ApplicationId</span>
                </div>
                <div class="card-body">
                    <div class="card mb-4 bg-light">
                        <div class="card-body">
                            <h5 class="card-title text-secondary border-bottom pb-2">Application Summary</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <strong>Applicant Name:</strong> @Model.UserFullName
                                </div>
                                <div class="col-md-6">
                                    <strong>Email:</strong> @Model.UserEmail
                                </div>
                                <div class="col-md-6">
                                    <strong>Certification:</strong> @Model.CertificationName
                                </div>
                                <div class="col-md-6">
                                    <strong>Submission Date:</strong> @Model.SubmittedDate.ToShortDateString()
                                </div>
                                <div class="col-md-6">
                                    <strong>Current Status:</strong> <span class="badge bg-success">Approved</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="AssignBadge" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ApplicationId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="BadgeName" class="form-label font-weight-bold">Badge Name <span class="text-danger">*</span></label>
                            <input asp-for="BadgeName" class="form-control" placeholder="e.g. Certified Security Professional" />
                            <span asp-validation-for="BadgeName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BadgeId" class="form-label font-weight-bold">Badge ID</label>
                            <input asp-for="BadgeId" class="form-control" placeholder="Leave blank to auto-generate (e.g. BDG-00001)" />
                            <span asp-validation-for="BadgeId" class="text-danger"></span>
                            <div class="form-text">If left blank, custom ID will be generated automatically as BDG-XXXXX.</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>Assign Badge & Complete Application
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
