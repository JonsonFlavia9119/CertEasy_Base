@model CertEasy.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid" id="dashboardContainer">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">System Configuration Hub</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs" id="adminTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="applications-tab" data-bs-toggle="tab" data-bs-target="#applications" type="button" role="tab">All Invoices / Applications</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="completed-applications-tab" data-bs-toggle="tab" data-bs-target="#completedApplications" type="button" role="tab">Completed Applications</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="addresses-tab" data-bs-toggle="tab" data-bs-target="#addresses" type="button" role="tab">Addresses</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="education-tab" data-bs-toggle="tab" data-bs-target="#education" type="button" role="tab">Education Records</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="certification-tab" data-bs-toggle="tab" data-bs-target="#certification" type="button" role="tab">Certifications</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="exams-tab" data-bs-toggle="tab" data-bs-target="#exams" type="button" role="tab">Exams</button>
                        </li>
                    </ul>
                    <div class="tab-content p-3" id="adminTabsContent">
                        <div class="tab-pane fade show active" id="applications" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Certification</th>
                                            <th>Submission Date</th>
                                            <th>Status</th>
                                            <th style="width: 260px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var app in Model.PendingApplications)
                                        {
                                            <tr>
                                                <td>@(app.User?.FirstName + " " + app.User?.LastName)</td>
                                                <td>@app.Certification?.Name</td>
                                                <td>@app.CreatedDate.ToShortDateString()</td>
                                                <td>
                                                    <span class="badge @(app.StatusID == 200 ? "bg-success" : (app.StatusID == 112 || app.StatusID == 7 ? "bg-success" : (app.StatusID == 113 || app.StatusID == 8 ? "bg-danger" : "bg-warning")))">
                                                        @(app.StatusID == 200 ? "Completed" : (app.StatusID == 112 || app.StatusID == 7 ? "Approved" : (app.StatusID == 113 || app.StatusID == 8 ? "Rejected" : "In Review")))
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <form asp-action="Approve" asp-route-id="@app.Id" method="post" style="display:inline;">
                                                            <button type="submit" class="btn btn-success" @(app.StatusID == 112 || app.StatusID == 7 || app.StatusID == 200 ? "disabled" : "")>Approve</button>
                                                        </form>
                                                        <form asp-action="Reject" asp-route-id="@app.Id" method="post" class="ms-1" style="display:inline;">
                                                            <button type="submit" class="btn btn-danger" @(app.StatusID == 113 || app.StatusID == 8 || app.StatusID == 200 ? "disabled" : "")>Reject</button>
                                                        </form>
                                                        @if (app.StatusID == 7 || app.StatusID == 112)
                                                        {
                                                            <a asp-action="AssignBadge" asp-route-id="@app.Id" class="btn btn-primary ms-1">
                                                                <i class="bi bi-award me-1"></i>Assign Badge
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.PendingApplications.Any())
                                        {
                                            <tr><td colspan="5" class="text-center">No applications found.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="completedApplications" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered align-middle" id="completedApplicationsGrid">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>App ID</th>
                                            <th>User Name</th>
                                            <th>Certification</th>
                                            <th>Assigned Badge Name</th>
                                            <th>Badge ID</th>
                                            <th>Badge Assigned Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var app in Model.CompletedApplications)
                                        {
                                            var displayBadgeName = !string.IsNullOrEmpty(app.BadgeName) ? app.BadgeName : (app.Certification?.Name ?? "Certified Professional");
                                            <tr>
                                                <td>#@app.Id</td>
                                                <td>@(app.User != null ? (app.User.FirstName + " " + app.User.LastName) : "N/A")</td>
                                                <td>@(app.Certification?.Name ?? "N/A")</td>
                                                <td>
                                                    <a asp-action="ViewBadge" asp-route-id="@app.Id" target="_blank" class="badge bg-primary text-wrap text-decoration-none shadow-sm fs-6 p-2">
                                                        <i class="bi bi-award-fill me-1"></i>@displayBadgeName <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                                    </a>
                                                </td>
                                                <td><code>@(app.BadgeId ?? ("BDG-" + app.Id.ToString("D5")))</code></td>
                                                <td>@(app.BadgeAssignedDate?.ToShortDateString() ?? app.UpdatedDate?.ToShortDateString() ?? "N/A")</td>
                                                <td>
                                                    <span class="badge bg-success">Completed (200)</span>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.CompletedApplications.Any())
                                        {
                                            <tr><td colspan="7" class="text-center text-muted py-4">No completed applications found.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="addresses" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead>
                                        <tr>
                                            <th>Street</th>
                                            <th>City</th>
                                            <th>State</th>
                                            <th>Postal Code</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: addresses">
                                        <tr>
                                            <td data-bind="text: street"></td>
                                            <td data-bind="text: city"></td>
                                            <td data-bind="text: state"></td>
                                            <td data-bind="text: postalCode"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="education" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead>
                                        <tr>
                                            <th>Institution</th>
                                            <th>Name</th>
                                            <th>Description</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: educations">
                                        <tr>
                                            <td data-bind="text: institution"></td>
                                            <td data-bind="text: name"></td>
                                            <td data-bind="text: description"></td>
                                            <td>
                                                <span class="badge" data-bind="text: isActive ? 'Active' : 'Inactive', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="certification" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Description</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: certifications">
                                        <tr>
                                            <td data-bind="text: name"></td>
                                            <td data-bind="text: description"></td>
                                            <td>
                                                <span class="badge" data-bind="text: isActive ? 'Active' : 'Inactive', css: isActive ? 'bg-success' : 'bg-secondary'"></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="exams" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-sm">
                                    <thead>
                                        <tr>
                                            <th>Exam Name</th>
                                            <th>Center</th>
                                            <th>Slot</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var exam in Model.Exams)
                                        {
                                            <tr>
                                                <td>@exam.ExamName</td>
                                                <td>@exam.ExamCenter</td>
                                                <td>@exam.ExamSlot.ToString("g")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function DashboardViewModel() {
            var self = this;
            
            self.addresses = ko.observableArray([
                @foreach (var addr in Model.Addresses)
                {
                    @: { street: '@addr.Line1', city: '@addr.City', state: '@addr.State', postalCode: '@addr.ZipCode' },
                }
            ]);

            self.educations = ko.observableArray([
                @foreach (var edu in Model.Educations)
                {
                    @: { institution: '@edu.InstituteName', name: '@edu.Name', description: '@edu.Description', isActive: @edu.IsActive.ToString().ToLower() },
                }
            ]);

            self.certifications = ko.observableArray([
                @foreach (var cert in Model.Certifications)
                {
                    @: { name: '@cert.Name', description: '@cert.Description', isActive: @cert.IsActive.ToString().ToLower() },
                }
            ]);
        }

        $(document).ready(function() {
            ko.applyBindings(new DashboardViewModel(), document.getElementById('dashboardContainer'));
        });
    </script>
}
