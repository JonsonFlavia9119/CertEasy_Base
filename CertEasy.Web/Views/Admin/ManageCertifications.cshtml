@model IEnumerable<CertEasy.Model.Certification>
@{
    ViewData["Title"] = "Manage Certifications";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Certifications</h2>
        <a asp-action="CreateCertification" class="btn btn-primary">Add New Certification</a>
    </div>

    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Obtained Year</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ObtainedYear</td>
                    <td>@item.Description</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="EditCertification" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                            <form asp-action="ToggleCertification" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-warning">Toggle</button>
                            </form>
                            <form asp-action="DeleteCertification" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this certification?');">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
