@model CertEasy.Model.Exam
@{
    ViewData["Title"] = "Create Exam";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Exam Details</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateExam" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="ExamName" class="form-label">Exam Name</label>
                        <input asp-for="ExamName" class="form-control" placeholder="e.g. Fall 2024 Certification" />
                        <span asp-validation-for="ExamName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExamCenter" class="form-label">Exam Center</label>
                        <input asp-for="ExamCenter" class="form-control" placeholder="e.g. London Testing Hub" />
                        <span asp-validation-for="ExamCenter" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExamSlot" class="form-label">Exam Slot (Date and Time)</label>
                        <input asp-for="ExamSlot" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ExamSlot" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="ManageExams" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Create Exam
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-info shadow-sm">
            <h6><i class="bi bi-info-circle-fill"></i> Guidance</h6>
            <p class="small mb-0">
                Use this form to add a new exam session to the system. 
                Ensure the exam name is descriptive for candidates, and double-check the slot time as it will be used for scheduling.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}