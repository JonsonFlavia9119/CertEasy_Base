@model IEnumerable<CertEasy.Model.Address>
@{ ViewData["Title"] = "Manage Addresses"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Addresses</h2>
        <a asp-action="CreateAddress" class="btn btn-primary">Add New Address</a>
    </div>

    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Address Line 1</th>
                <th>City</th>
                <th>State</th>
                <th>Country</th>
                <th>Zip Code</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Line1</td>
                    <td>@item.City</td>
                    <td>@item.State</td>
                    <td>@item.Country</td>
                    <td>@item.ZipCode</td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="EditAddress" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                            <form asp-action="DeleteAddress" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this address?');">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>