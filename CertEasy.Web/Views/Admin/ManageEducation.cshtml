@model IEnumerable<CertEasy.Model.EducationLevel>

@{
    ViewData["Title"] = "Manage Education Levels";
}

<h2>Manage Education Levels</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-header">Add New Education Level</div>
    <div class="card-body">
        <form asp-action="AddEducation" method="post" class="row g-3">
            <div class="col-md-4">
                <input name="Name" class="form-control" placeholder="Level Name" required />
            </div>
            <div class="col-md-6">
                <input name="Description" class="form-control" placeholder="Description" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleEducation" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(item.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>