@model IEnumerable<CertEasy.Model.Education>
@{
    ViewData["Title"] = "Manage Education Qualifications";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Education Qualifications</h1>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-action="CreateEducation" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-lg"></i> Add New
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Institute</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.InstituteName</td>
                    <td>
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                            @(item.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>@item.CreatedDate.ToShortDateString()</td>
                    <td>
                        <div class="btn-group me-2">
                            <a asp-action="EditEducation" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="DeleteEducation" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this?');" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>