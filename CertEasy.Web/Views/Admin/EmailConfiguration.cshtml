@model CertEasy.Web.Models.EmailConfigurationViewModel
@{
    ViewData["Title"] = "Email Configuration";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Email Configuration</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item active">Email Configuration</li>
    </ol>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-envelope me-1"></i>
                    Provider Settings (Resend)
                </div>
                <div class="card-body">
                    <form asp-action="EmailConfiguration" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="ProviderName" class="form-label">Provider Name</label>
                            <input asp-for="ProviderName" class="form-control" readonly />
                            <span asp-validation-for="ProviderName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SenderEmail" class="form-label">Sender Email</label>
                            <input asp-for="SenderEmail" class="form-control" placeholder="e.g. notifications@yourdomain.com" />
                            <span asp-validation-for="SenderEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SenderName" class="form-label">Sender Name</label>
                            <input asp-for="SenderName" class="form-control" placeholder="e.g. CertEasy Admin" />
                            <span asp-validation-for="SenderName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ApiKey" class="form-label">Resend API Key</label>
                            <input asp-for="ApiKey" class="form-control" type="password" placeholder="Leave blank to keep existing key" value="" />
                            @if (Model.ApiKey == "********")
                            {
                                <small class="text-muted">Current key is saved. Enter a new one to update.</small>
                            }
                            <span asp-validation-for="ApiKey" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="EnableSsl" class="form-check-input" />
                            <label asp-for="EnableSsl" class="form-check-label">Enable SSL</label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-vial me-1"></i>
                    Test Email Service
                </div>
                <div class="card-body">
                    <p class="text-muted">Enter an email address below to send a test message using the current Resend settings.</p>
                    <div class="input-group mb-3">
                        <input type="email" id="testRecipient" class="form-control" placeholder="recipient@example.com" aria-label="Recipient's email">
                        <button class="btn btn-outline-secondary" type="button" id="btnSendTest">
                            <i class="fas fa-paper-plane me-1"></i> Send Test
                        </button>
                    </div>
                    <div id="testResult" class="mt-3" style="display: none;">
                        <div class="alert alert-info" id="testResultMessage">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('#btnSendTest').click(function() {
                const email = $('#testRecipient').val();
                if (!email) {
                    alert('Please enter a recipient email address.');
                    return;
                }

                const $btn = $(this);
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Sending...');
                $('#testResult').hide();

                $.post('@Url.Action("TestEmail")', { 
                    targetEmail: email, 
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() 
                })
                .done(function(data) {
                    $('#testResult').show();
                    const $alert = $('#testResultMessage');
                    $alert.removeClass('alert-info alert-danger alert-success');
                    
                    if (data.success) {
                        $alert.addClass('alert-success').text(data.message);
                    } else {
                        $alert.addClass('alert-danger').text(data.message);
                    }
                })
                .fail(function() {
                    $('#testResult').show();
                    $('#testResultMessage').addClass('alert-danger').text('An error occurred while trying to send the test email.');
                })
                .always(function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Send Test');
                });
            });
        });
    </script>
}