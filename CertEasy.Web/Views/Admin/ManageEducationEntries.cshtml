@model IEnumerable<CertEasy.Model.Education>
@{ ViewData["Title"] = "Manage Education Entries"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Education Entries</h2>
        <a asp-action="CreateEducation" class="btn btn-primary">Add New Education</a>
    </div>

    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Institution</th>
                <th>Field of Study</th>
                <th>Level</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.InstitutionName</td>
                    <td>@item.FieldOfStudy</td>
                    <td>@item.EducationLevel?.Name</td>
                    <td>@item.GraduationYear</td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="EditEducation" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                            <form asp-action="DeleteEducation" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this education entry?');">
                                <button type="submit" class="btn btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>