@{
    ViewData["Title"] = "Error";
    var errorMessage = ViewData["ErrorMessage"] as string ?? "An error occurred while processing your request.";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Error</h4>
                </div>
                <div class="card-body">
                    <p class="lead text-danger">@errorMessage</p>
                    <hr />
                    <p>Please contact the system administrator if this issue persists.</p>
                    <div class="mt-4">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">Go Back</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>