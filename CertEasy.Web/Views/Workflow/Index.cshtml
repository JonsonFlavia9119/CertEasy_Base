@model IEnumerable<CertEasy.Model.Application>
@{
    ViewData["Title"] = "Applications";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2>@(isAdmin ? "All Submitted Applications" : "My Applications")</h2>
        @if (!isAdmin)
        {
            <a asp-action="Apply" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Application
            </a>
        }
    </div>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No applications found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                @if (isAdmin)
                                {
                                    <th>Applicant</th>
                                }
                                <th>Certification</th>
                                <th>Exam Details</th>
                                <th>Status</th>
                                <th>Submitted On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td><strong>#@app.Id</strong></td>
                                    @if (isAdmin)
                                    {
                                        <td>
                                            @(app.User != null ? $"{app.User.FirstName} {app.User.LastName}" : "Unknown User")<br />
                                            <small class="text-muted">@app.User?.Email</small>
                                        </td>
                                    }
                                    <td>@(app.Certification?.Name ?? "N/A")</td>
                                    <td>
                                        @if (app.Exam != null)
                                        {
                                            <div><strong>@app.Exam.ExamName</strong></div>
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt"></i> @app.Exam.ExamCenter<br />
                                                <i class="bi bi-calendar-event"></i> @app.Exam.ExamSlot.ToString("MMM dd, yyyy HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">No exam scheduled</span>
                                        }
                                    </td>
                                    <td>
                                        @{ 
                                            var badgeClass = "bg-secondary";
                                            switch (app.StatusID)
                                            {
                                                case 1: badgeClass = "bg-info"; break; // New
                                                case 7: badgeClass = "bg-success"; break; // Approved
                                                case 8: badgeClass = "bg-danger"; break; // Rejection
                                                case 6: badgeClass = "bg-primary"; break; // Review
                                            }
                                        }
                                        <span class="badge @badgeClass">
                                            @(app.Status?.StatusName ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>@app.SubmittedDate.ToString("g")</td>
                                    <td>
                                        @if (app.StatusID == (int)CertEasy.Model.ApplicationStatus.Rejection)
                                        {
                                            <form asp-controller="Workflow" asp-action="Resubmit" asp-route-id="@app.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Resubmit
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>